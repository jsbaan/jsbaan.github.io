source "https://rubygems.org"

# Pins Jekyll and plugins to the exact versions GitHub Pages uses.
# Includes jekyll-feed, jekyll-paginate, jekyll-sitemap and jekyll-seo-tag.
gem "github-pages", group: :jekyll_plugins

# Removed from the Ruby standard library in 3.0; needed for `jekyll serve`.
gem "webrick"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
